# Vite client environment variables
# Duplicate this file to .env and adjust as needed.

# Base URL for API requests. For local dev leave default backend.
VITE_API_URL=http://localhost:3001

# Optional delay (ms) before redirecting after successful 2FA.
# Defaults to 600 if unset. Set to 0 to disable the delay (useful in tests).
VITE_2FA_REDIRECT_DELAY_MS=600
